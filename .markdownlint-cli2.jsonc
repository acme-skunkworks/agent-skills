// Markdown linting for agent-skills.
//
// Rules come entirely from the shared house-style config
// `@acme-skunkworks/markdownlint-config` (consumed via `extends`, kept in
// lockstep with the org). It disables MD013/MD033/MD040/MD041 so long-form
// prose and frontmatter-first changelog entries lint clean.
//
// markdownlint-cli2 auto-discovers this file at the repo root — which is also
// how the shared `preflight` skill invokes the linter (no `--config` flag), so
// CLI runs and the preflight gate stay in agreement. The `globs` mirror
// preflight's own ignore set.
{
  "config": {
    "extends": "@acme-skunkworks/markdownlint-config"
  },
  // Skip gitignored paths (node_modules, `.claude/` worktrees, etc.) so local
  // runs lint exactly the tracked set CI sees.
  "gitignore": true,
  "globs": [
    "**/*.{md,mdx}",
    "!**/node_modules/**",
    "!**/dist/**",
    "!.agents/skills/**",
    "!.claude/skills/**"
  ]
}
